# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://zgaakmfzjonhewiletqc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: SUPABASE_SERVICE_ROLE_KEY für E-Mail-Invites und Invite-Registrierung
# (auth.admin.createUser). Wenn leer, nutzt die App Edge Functions als Fallback
# (`invite-member`, `register-invite`).
SUPABASE_SERVICE_ROLE_KEY=

# Optional but recommended: Resend for reliable vacation invite emails
# (sends the /invite/{token} link). Without it, existing auth users get a
# magic login link via Supabase Auth instead — inviteUserByEmail alone does
# not re-mail people who already have an account.
# https://resend.com/api-keys
RESEND_API_KEY=
# Optional verified sender, e.g. "Vacation Planer <einladung@deine-domain.de>"
# RESEND_FROM=

# Optional: stable Server Action encryption across Vercel builds (base64 AES-16/24/32).
# Reduces "Server Action was not found" after deploys when clients stay open.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Browser: Google Maps JavaScript API (interactive spot map)
# Google Cloud → enable Maps JavaScript API → API key with HTTP referrer restriction
# (e.g. https://vacation-bice.vercel.app/* and http://localhost:3000/*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server: Place Photos + Street View / Static Map + Routes API (drive ETAs)
# Google Cloud → enable Places API (New), optionally Geocoding, Street View Static /
# Maps Static, and Routes API for real km/minutes between planned stops.
# Prefer a key restricted to those APIs (IP restriction optional; Vercel egress IPs vary).
# When Places/Geocoding are unavailable, spot intake falls back to OpenStreetMap Nominatim.
GOOGLE_MAPS_API_KEY=
